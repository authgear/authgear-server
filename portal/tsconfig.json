// This file is for typechecking only.
// Parcel uses Babel to compile our TypeScript source files.
// So here we only include options that are related to typechecking.
{
  "compilerOptions": {
    "target": "ES2015",
    // ES2021.Intl for Intl.ListFormat. Typings only -- target stays ES2015,
    // and every Intl API it declares is above the .browserslistrc floor
    // (Intl.ListFormat: Safari/iOS 14.1, Firefox 78, Chrome 72).
    "lib": ["DOM", "ES2015", "ES2021.Intl"],
    "moduleResolution": "bundler",
    "module": "es2020",
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "noImplicitAny": false // Set to false because somehow our codebase contains a lot of implicit any types
  },
  "include": ["./src", "vite.config.ts"]
}
